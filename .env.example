# Copy to .env.local for development. All NEXT_PUBLIC_* values are safe to expose; RLS protects data.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable" key (sb_publishable_...) on new projects, or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Allow new accounts to be created. Set to false after you have created yours.
NEXT_PUBLIC_ALLOW_SIGNUP=true

# Public origin used in auth emails when the request origin is unavailable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for /api/cron/keepalive (Vercel sets the Authorization header from this).
CRON_SECRET=
